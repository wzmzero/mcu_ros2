{
  "names": {
    "microxrcedds_client": {
      "cmake-args": ["-DUCLIENT_PROFILE_DISCOVERY=OFF", "-DUCLIENT_PROFILE_UDP=OFF", "-DUCLIENT_PROFILE_STREAM_FRAMING=ON", "-DUCLIENT_PROFILE_CUSTOM_TRANSPORT=ON"]
    },
    "rmw_microxrcedds": {
      "cmake-args": ["-DRMW_UXRCE_TRANSPORT=custom", "-DRMW_UXRCE_MAX_NODES=1", "-DRMW_UXRCE_MAX_PUBLISHERS=10", "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=5", "-DRMW_UXRCE_MAX_SERVICES=4", "-DRMW_UXRCE_MAX_CLIENTS=4", "-DRMW_UXRCE_MAX_HISTORY=12"]
    }
  }
}
