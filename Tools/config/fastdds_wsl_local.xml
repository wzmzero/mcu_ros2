<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional profile for Agent and ROS nodes running inside the same WSL instance.
     XRCE UDP still accepts MCU traffic on port 8888. DDS uses loopback UDP only;
     ROS nodes on other computers cannot use this DDS profile to reach this Agent. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>wsl_local_udp</transport_id>
                <type>UDPv4</type>
                <interfaceWhiteList>
                    <address>127.0.0.1</address>
                </interfaceWhiteList>
                <maxInitialPeersRange>20</maxInitialPeersRange>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="wsl_local_udp_participant" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>wsl_local_udp</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <initialPeersList>
                        <locator>
                            <udpv4>
                                <address>127.0.0.1</address>
                            </udpv4>
                        </locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
